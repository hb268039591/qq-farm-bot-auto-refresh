# Copy this file to .env. Replace DATA_DIR with the old container's HOST data path.
# Example Synology: /volume1/docker/qq-farm-bot/data
# Example QNAP: /share/Container/qq-farm-bot/data
DATA_DIR=../data
PORT=3007
TZ=Asia/Shanghai
FARM_AUTO_START=1
NODE_IMAGE=node:20.19.6-alpine3.21
NPM_REGISTRY=https://registry.npmjs.org/
